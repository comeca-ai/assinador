{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assinaja",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-03",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "assinaja", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "cloudflare/migrations" }],
  "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "assinaja-documentos" }],
  "observability": { "enabled": false }
}
